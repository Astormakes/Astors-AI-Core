{
 "aac": 2,
 "domain": "Assistant",
 "cards": {
  "chat": {
   "type": "chat",
   "title": "Chat",
   "settings": {
    "ha_agent": true
   },
   "version": "2.4.1"
  },
  "charter": {
   "type": "relay",
   "title": "Charter",
   "settings": {
    "script": "context = input(\"in\")\ncontext.add(\"charter\", \"\"\"Be kind.\"\"\", at=\"first\", role=\"system\")\noutput(\"out\", context)\n"
   },
   "version": "3.1.0"
  },
  "time": {
   "type": "relay",
   "title": "Time",
   "settings": {
    "script": "context = input(\"in\")\ncontext.attach(\"time\", f\"Local time: {now():%A %Y-%m-%d %H:%M}\")\noutput(\"out\", context)\n"
   },
   "version": "3.1.0"
  },
  "model": {
   "type": "model",
   "title": "Model",
   "settings": {},
   "version": "2.2.3"
  },
  "lists": {
   "type": "lists",
   "title": "Lists",
   "settings": {},
   "version": "1.3.0"
  },
  "home": {
   "type": "homeassistant",
   "title": "Home",
   "settings": {},
   "version": "1.2.1"
  },
  "calendar": {
   "type": "calendar",
   "title": "Calendar",
   "settings": {},
   "version": "1.3.0"
  },
  "microphone": {
   "type": "microphone",
   "title": "Microphone",
   "settings": {
    "source": "any"
   },
   "version": "2.10.1"
  },
  "audio_clipper": {
   "type": "pause_cut",
   "title": "Audio clipper",
   "settings": {
    "pause": 800
   },
   "version": "2.10.1"
  },
  "speech_to_text": {
   "type": "speech_to_text",
   "title": "Speech to text",
   "settings": {},
   "version": "2.10.1"
  },
  "text_to_speech": {
   "type": "text_to_speech",
   "title": "Text to speech",
   "settings": {},
   "version": "2.10.2"
  },
  "speaker": {
   "type": "speaker",
   "title": "Speaker",
   "settings": {},
   "version": "2.10.2"
  },
  "stop_word": {
   "type": "relay",
   "title": "Stop word",
   "settings": {
    "script": "context = input(\"in\")\nheard = context.get(\"speech_to_text.heard\")\nif heard and \"stop\" in heard.text.lower():\n    stop()\n    output(\"stop\", context)\n"
   },
   "version": "3.1.0"
  },
  "wake_word": {
   "type": "relay",
   "title": "Wake word",
   "settings": {
    "script": "context = input(\"in\")\nheard = context.get(\"speech_to_text.heard\")\nif heard and any(word in heard.text.lower() for word in [\"computer\"]):\n    output(\"yes\", context)\n"
   },
   "version": "3.1.0"
  },
  "follow_up": {
   "type": "relay",
   "title": "Follow-up",
   "settings": {
    "script": "context = input(\"in\")\nheard = context.get(\"speech_to_text.heard\")\nif heard:\n    # you started talking less than 6 s after AAC spoke at that satellite (long answers too)\n    spoke = audio.satellites.get(heard.data.get(\"mic\"), {}).get(\"seconds\", 999999)\n    said_for = heard.data.get(\"seconds\") or 0\n    named = any(word in heard.text.lower() for word in [\"stop\", \"computer\"])\n    if not heard.data.get(\"aac_spoke\") and spoke - said_for < 6 and not named:\n        output(\"yes\", context)\n"
   },
   "version": "3.1.0"
  },
  "spoken_turn": {
   "type": "relay",
   "title": "Spoken turn",
   "settings": {
    "script": "context = input(\"chat\", read=True) + input(\"in\")\ncontext.attach(\"rules\", \"\"\"You are heard and answer aloud: one or two short sentences, plain words, no lists. If you need to look something up or do something, call the tool first, then answer.\"\"\")\noutput(\"out\", context)\n"
   },
   "version": "3.1.0"
  },
  "follow_up_turn": {
   "type": "relay",
   "title": "Follow-up turn",
   "settings": {
    "script": "context = input(\"chat\", read=True) + input(\"in\")\nheard = context.get(\"speech_to_text.heard\")\nif heard:\n    heard.text = \"(Said right after you spoke aloud; it may not be meant for you. If it is not, answer only: nothing) \" + heard.text\ncontext.attach(\"rules\", \"\"\"You are heard and answer aloud: one or two short sentences, plain words, no lists. If you need to look something up or do something, call the tool first, then answer.\"\"\")\noutput(\"out\", context)\n"
   },
   "version": "3.1.0"
  },
  "answer": {
   "type": "relay",
   "title": "Answer",
   "settings": {},
   "version": "3.1.0"
  }
 },
 "wires": [
  {
   "from": "chat.said",
   "to": "charter.in"
  },
  {
   "from": "charter.out",
   "to": "time.in"
  },
  {
   "from": "time.out",
   "to": "model.in"
  },
  {
   "from": "model.out",
   "to": "lists.in"
  },
  {
   "from": "lists.out",
   "to": "model.in"
  },
  {
   "from": "model.out",
   "to": "home.in"
  },
  {
   "from": "home.out",
   "to": "model.in"
  },
  {
   "from": "model.out",
   "to": "calendar.in"
  },
  {
   "from": "calendar.out",
   "to": "model.in"
  },
  {
   "from": "microphone.out",
   "to": "audio_clipper.in"
  },
  {
   "from": "audio_clipper.out",
   "to": "speech_to_text.in"
  },
  {
   "from": "speech_to_text.out",
   "to": "stop_word.in"
  },
  {
   "from": "speech_to_text.out",
   "to": "wake_word.in"
  },
  {
   "from": "speech_to_text.out",
   "to": "follow_up.in"
  },
  {
   "from": "wake_word.yes",
   "to": "spoken_turn.in"
  },
  {
   "from": "follow_up.yes",
   "to": "follow_up_turn.in"
  },
  {
   "from": "answer.out",
   "to": "text_to_speech.in"
  },
  {
   "from": "text_to_speech.out",
   "to": "speaker.in"
  },
  {
   "from": "stop_word.stop",
   "to": "charter.in"
  },
  {
   "from": "spoken_turn.out",
   "to": "charter.in"
  },
  {
   "from": "follow_up_turn.out",
   "to": "charter.in"
  },
  {
   "from": "chat.provides",
   "to": "spoken_turn.chat"
  },
  {
   "from": "chat.provides",
   "to": "follow_up_turn.chat"
  },
  {
   "from": "answer.out",
   "to": "chat.answers"
  },
  {
   "from": "model.out",
   "to": "answer.in"
  }
 ],
