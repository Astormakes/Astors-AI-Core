      }
     },
     "version": "1.3.0"
    },
    "calendar": {
     "type": "calendar",
     "title": "Calendar",
     "settings": {},
     "version": "2.1.0"
    },
    "microphone": {
     "type": "microphone",
     "title": "Microphone",
     "settings": {
      "source": "any",
      "access": {
       "audio": "full"
      }
     },
     "version": "3.1.0"
    },
    "audio_clipper": {
     "type": "pause_cut",
     "title": "Audio clipper",
     "settings": {
      "pause": 800
     },
     "version": "3.0.0"
