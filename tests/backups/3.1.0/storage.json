    "speech_to_text": {
     "type": "speech_to_text",
     "title": "Speech to text",
     "settings": {},
     "version": "3.0.0"
    },
    "text_to_speech": {
     "type": "text_to_speech",
     "title": "Text to speech",
     "settings": {},
     "version": "3.2.0"
    },
    "speaker": {
     "type": "speaker",
     "title": "Speaker",
     "settings": {
      "access": {
       "audio": "full"
      }
     },
     "version": "3.1.0"
    },
    "stop_word": {
     "type": "relay",
     "title": "Stop word",
     "settings": {
      "script": "context = input(\"in\")\nheard = context.get(\"speech_to_text.said\")\nif heard and \"stop\" in heard.text.lower():\n    stop()\n"
     },
     "version": "4.2.0"
    },
    "wake_word": {
     "type": "relay",
     "title": "Wake word",
     "settings": {
      "script": "context = input(\"in\")\nheard = context.get(\"speech_to_text.said\")\nif heard and any(word in heard.text.lower() for word in [\"computer\"]):\n    output(\"yes\", context)\n"
     },
     "version": "4.2.0"
    },
    "follow_up": {
     "type": "relay",
     "title": "Follow-up",
     "settings": {
      "script": "context = input(\"in\")\nheard = context.get(\"speech_to_text.said\")\nif heard:\n    # you started talking less than 6 s after AAC spoke at that satellite (long answers too)\n    spoke = audio.satellites.get(heard.data.get(\"mic\"), {}).get(\"seconds\", 999999)\n    said_for = heard.data.get(\"seconds\") or 0\n    named = any(word in heard.text.lower() for word in [\"stop\", \"computer\"])\n    if not heard.data.get(\"aac_spoke\") and spoke - said_for < 6 and not named:\n        output(\"yes\", context)\n"
     },
     "version": "4.2.0"
    },
    "spoken_turn": {
     "type": "relay",
     "title": "Spoken turn",
     "settings": {
      "script": "context = input(\"chat\", read=True) + input(\"in\")\ncontext.add(\"rules\", \"\"\"You are heard and answer aloud: one or two short sentences, plain words, no lists. If you need to look something up or do something, call the tool first, then answer.\"\"\")\noutput(\"out\", context)\n"
     },
     "version": "4.2.0"
    },
    "follow_up_turn": {
     "type": "relay",
     "title": "Follow-up turn",
     "settings": {
      "script": "context = input(\"chat\", read=True) + input(\"in\")\nheard = context.get(\"speech_to_text.said\")\nif heard:\n    heard.text = \"(Said right after you spoke aloud; it may not be meant for you. If it is not, answer only: nothing) \" + heard.text\ncontext.add(\"rules\", \"\"\"You are heard and answer aloud: one or two short sentences, plain words, no lists. If you need to look something up or do something, call the tool first, then answer.\"\"\")\noutput(\"out\", context)\n"
     },
     "version": "4.2.0"
    }
