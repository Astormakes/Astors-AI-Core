     },
     "version": "3.1.0"
    },
    "charter": {
     "type": "relay",
     "title": "Charter",
     "settings": {
      "script": "context = input(\"in\")\ncontext.set(\"context.system\", \"\"\"Be kind.\"\"\")\noutput(\"out\", context)\n"
     },
     "version": "4.2.0"
    },
    "time": {
     "type": "relay",
     "title": "Time",
     "settings": {
      "script": "context = input(\"in\")\ncontext.add(\"time\", f\"Local time: {now():%A %Y-%m-%d %H:%M}\")\noutput(\"out\", context)\n"
     },
     "version": "4.2.0"
    },
    "model": {
     "type": "model",
     "title": "Model",
