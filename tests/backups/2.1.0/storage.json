{
 "aac2.domain.assistant": {
  "version": 1,
  "minor_version": 1,
  "key": "aac2.domain.assistant",
  "data": {
   "cards": {
    "chat": {
     "type": "chat",
     "title": "Chat",
     "settings": {
      "ha_agent": true
     },
     "version": "1.5.0"
    },
    "charter": {
     "type": "relay",
     "title": "Charter",
     "settings": {
      "position": "start",
      "text": "Be kind.",
      "replace": true
     },
     "version": "1.2.0"
    },
    "time": {
     "type": "relay",
     "title": "Time",
     "settings": {
      "position": "after",
      "text": "Local time: {{ now().strftime('%A %Y-%m-%d %H:%M') }}",
      "replace": false
     },
     "version": "1.2.0"
    },
    "model": {
     "type": "model",
     "title": "Model",
     "settings": {},
     "version": "1.3.0"
    },
    "lists": {
     "type": "lists",
     "title": "Lists",
     "settings": {},
     "version": "1.1.0"
    },
    "home": {
     "type": "homeassistant",
     "title": "Home",
     "settings": {
      "default": "hidden"
     },
     "version": "1.0.0"
    },
    "calendar": {
     "type": "calendar",
     "title": "Calendar",
     "settings": {},
     "version": "1.1.0"
    },
    "mic": {
     "type": "microphone",
     "title": "Microphone",
     "settings": {
      "source": "any"
     },
     "version": "2.2.0"
    },
    "cut": {
     "type": "pause_cut",
     "title": "Audio clipper",
     "settings": {
      "pause": 800
     },
     "version": "2.2.0"
    },
    "ears": {
     "type": "speech_to_text",
     "title": "Speech to text",
     "settings": {},
     "version": "2.2.0"
    },
    "voice": {
     "type": "text_to_speech",
     "title": "Text to speech",
     "settings": {},
     "version": "2.2.0"
    },
    "speaker": {
     "type": "speaker",
     "title": "Speaker",
     "settings": {},
     "version": "2.2.0"
    },
    "stop_word": {
     "type": "conditional",
     "title": "Stop word",
     "settings": {
      "outputs": [
       "stop"
      ],
      "rules": [
       {
        "name": "says stop",
        "select": {
         "by": "kind",
         "value": "said",
         "which": "newest"
        },
        "test": "contains",
        "value": "stop",
        "actions": [
         {
          "do": "stop"
         },
         {
          "do": "output",
          "a": "stop"
         }
        ]
       }
      ]
     },
     "version": "1.1.0"
    },
    "wake": {
     "type": "conditional",
     "title": "Wake word",
     "settings": {
      "outputs": [
       "yes"
      ],
      "rules": [
       {
        "name": "says computer",
        "select": {
         "by": "kind",
         "value": "said",
         "which": "newest"
        },
        "test": "contains",
        "value": "computer",
        "actions": [
         {
          "do": "output",
          "a": "yes"
         }
        ]
       }
      ]
     },
     "version": "1.1.0"
    },
    "follow_up": {
     "type": "conditional",
     "title": "Follow-up",
     "settings": {
      "outputs": [
       "yes"
      ],
      "rules": [
       {
        "name": "AAC spoke there less than 10 s ago",
        "select": {
         "by": "kind",
         "value": "said",
         "which": "newest"
        },
        "test": "template",
        "value": "{{ entry is not none and audio.satellites.get(entry.data.mic, {}).get('seconds', 999999) < 10 and not (entry.text | lower is search('stop|computer')) }}",
        "actions": [
         {
          "do": "output",
          "a": "yes"
         }
        ]
       }
      ]
     },
     "version": "1.1.0"
    },
    "spoken": {
     "type": "relay",
     "title": "Spoken turn",
     "settings": {
      "position": "after",
      "replace": false,
      "text": "You are heard and answer aloud: one or two short sentences, plain words, no lists."
     },
     "version": "1.2.0"
    },
    "followed": {
     "type": "relay",
     "title": "Follow-up turn",
     "settings": {
      "position": "after",
      "replace": false,
      "text": "You are heard and answer aloud: one or two short sentences, plain words, no lists.",
      "add_tag": "ears.heard",
      "add_text": "(Said right after you spoke aloud; it may not be meant for you. If it is not, answer only: nothing) ",
      "add_where": "start"
     },
     "version": "1.2.0"
    },
    "answer": {
     "type": "relay",
     "title": "Answer",
     "settings": {},
     "version": "1.2.0"
    }
   },
   "wires": [
    {
     "from": "chat.said",
     "to": "charter.in"
    },
    {
     "from": "charter.out",
     "to": "time.in"
    },
    {
     "from": "time.out",
     "to": "model.in"
    },
    {
     "from": "model.out",
     "to": "lists.in"
    },
    {
     "from": "lists.out",
     "to": "model.in"
    },
    {
     "from": "model.out",
     "to": "home.in"
    },
    {
     "from": "home.out",
     "to": "model.in"
    },
    {
     "from": "model.out",
     "to": "calendar.in"
    },
    {
     "from": "calendar.out",
     "to": "model.in"
    },
    {
     "from": "mic.out",
     "to": "cut.in"
    },
    {
     "from": "cut.out",
     "to": "ears.in"
    },
    {
     "from": "ears.out",
     "to": "stop_word.in"
    },
    {
     "from": "ears.out",
     "to": "wake.in"
    },
    {
     "from": "ears.out",
     "to": "follow_up.in"
    },
    {
     "from": "wake.yes",
     "to": "spoken.in"
    },
    {
     "from": "follow_up.yes",
     "to": "followed.in"
    },
    {
     "from": "answer.out",
     "to": "voice.in"
    },
    {
     "from": "voice.out",
     "to": "speaker.in"
    },
    {
     "from": "stop_word.stop",
     "to": "charter.in"
    },
    {
     "from": "spoken.out",
     "to": "charter.in"
    },
    {
     "from": "followed.out",
     "to": "charter.in"
    },
    {
     "from": "chat.provides",
     "to": "spoken.reads"
    },
    {
     "from": "chat.provides",
     "to": "followed.reads"
    },
    {
     "from": "answer.out",
     "to": "chat.answers"
    },
    {
     "from": "model.out",
     "to": "answer.in"
    }
   ],
