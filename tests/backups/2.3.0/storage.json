  "key": "aac2.domain.assistant",
  "data": {
   "cards": {
    "chat": {
     "type": "chat",
     "title": "Chat",
     "settings": {
      "ha_agent": true
     },
     "version": "2.0.0"
    },
    "charter": {
     "type": "relay",
     "title": "Charter",
     "settings": {
      "script": "@new(\"charter\")\ndef charter(e):\n    e.text = \"\"\"Be kind.\"\"\"\n"
     },
     "version": "2.1.0"
    },
    "time": {
     "type": "relay",
     "title": "Time",
     "settings": {
      "script": "@new(\"time\", at=\"end\", replace=False)\ndef time(e):\n    e.text = f\"Local time: {now():%A %Y-%m-%d %H:%M}\"\n"
     },
     "version": "2.1.0"
    },
    "model": {
     "type": "model",
     "title": "Model",
     "settings": {},
     "version": "2.0.0"
    },
    "lists": {
     "type": "lists",
