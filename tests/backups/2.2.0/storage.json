     "type": "speaker",
     "title": "Speaker",
     "settings": {},
     "version": "2.10.0"
    },
    "stop_word": {
     "type": "relay",
     "title": "Stop word",
     "settings": {
      "script": "@on(\"*\", kind=\"said\")\ndef says_stop(e):\n    if \"stop\" in e.text.lower():\n        stop()\n        output(\"stop\")\n"
     },
     "version": "2.0.0"
    },
    "wake": {
     "type": "relay",
     "title": "Wake word",
     "settings": {
      "script": "@on(\"*\", kind=\"said\")\ndef wake_word(e):\n    if any(word in e.text.lower() for word in [\"computer\"]):\n        output(\"yes\")\n"
     },
     "version": "2.0.0"
    },
    "follow_up": {
     "type": "relay",
     "title": "Follow-up",
     "settings": {
      "script": "@on(\"*\", kind=\"said\")\ndef follow_up(e):\n    # you started talking less than 6 s after AAC spoke at that satellite (long answers too)\n    spoke = audio.satellites.get(e.data.get(\"mic\"), {}).get(\"seconds\", 999999)\n    said_for = e.data.get(\"seconds\") or 0\n    named = any(word in e.text.lower() for word in [\"stop\", \"computer\"])\n    if not e.data.get(\"aac_spoke\") and spoke - said_for < 6 and not named:\n        output(\"yes\")\n"
     },
     "version": "2.0.0"
    },
    "spoken": {
     "type": "relay",
     "title": "Spoken turn",
     "settings": {
      "script": "@new(\"rules\", at=\"end\", replace=False)\ndef rules(e):\n    e.text = \"\"\"You are heard and answer aloud: one or two short sentences, plain words, no lists. If you need to look something up or do something, call the tool first, then answer.\"\"\"\n"
     },
     "version": "2.0.0"
    },
    "followed": {
     "type": "relay",
     "title": "Follow-up turn",
     "settings": {
      "script": "@new(\"rules\", at=\"end\", replace=False)\ndef rules(e):\n    e.text = \"\"\"You are heard and answer aloud: one or two short sentences, plain words, no lists. If you need to look something up or do something, call the tool first, then answer.\"\"\"\n\n@on(\"ears.heard\")\ndef maybe_not_for_me(e):\n    e.text = \"(Said right after you spoke aloud; it may not be meant for you. If it is not, answer only: nothing) \" + e.text\n"
     },
     "version": "2.0.0"
    },
    "answer": {
     "type": "relay",
     "title": "Answer",
     "settings": {},
     "version": "2.0.0"
    }
   },
