     "version": "2.0.0"
    },
    "time": {
     "type": "relay",
     "title": "Time",
     "settings": {
      "script": "@new(\"time\", at=\"end\", replace=False)\ndef time(e):\n    e.text = f\"Local time: {now():%A %Y-%m-%d %H:%M}\"\n"
     },
     "version": "2.0.0"
    },
