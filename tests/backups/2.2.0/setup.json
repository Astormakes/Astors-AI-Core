{
 "aac": 2,
 "domain": "Assistant",
 "cards": {
  "chat": {
   "type": "chat",
   "title": "Chat",
   "settings": {
    "ha_agent": true
   },
   "version": "1.7.0"
  },
  "charter": {
   "type": "relay",
   "title": "Charter",
   "settings": {
    "script": "@new(\"charter\")\ndef charter(e):\n    e.text = \"\"\"Be kind.\"\"\"\n"
   },
   "version": "2.0.0"
  },
  "time": {
   "type": "relay",
   "title": "Time",
   "settings": {
    "script": "@new(\"time\", at=\"end\", replace=False)\ndef time(e):\n    e.text = f\"Local time: {now():%A %Y-%m-%d %H:%M}\"\n"
   },
   "version": "2.0.0"
  },
  "model": {
   "type": "model",
   "title": "Model",
   "settings": {},
   "version": "1.5.0"
  },
  "lists": {
   "type": "lists",
   "title": "Lists",
   "settings": {},
   "version": "1.2.0"
  },
  "home": {
   "type": "homeassistant",
   "title": "Home",
   "settings": {},
   "version": "1.2.0"
  },
  "calendar": {
   "type": "calendar",
   "title": "Calendar",
   "settings": {},
   "version": "1.1.0"
  },
  "mic": {
   "type": "microphone",
   "title": "Microphone",
   "settings": {
    "source": "any"
   },
   "version": "2.10.0"
  },
  "cut": {
   "type": "pause_cut",
   "title": "Audio clipper",
   "settings": {
    "pause": 800
   },
   "version": "2.10.0"
  },
  "ears": {
   "type": "speech_to_text",
   "title": "Speech to text",
   "settings": {},
   "version": "2.10.0"
  },
  "voice": {
   "type": "text_to_speech",
   "title": "Text to speech",
   "settings": {},
   "version": "2.10.0"
  },
  "speaker": {
   "type": "speaker",
   "title": "Speaker",
   "settings": {},
   "version": "2.10.0"
  },
  "stop_word": {
   "type": "relay",
   "title": "Stop word",
   "settings": {
    "script": "@on(\"*\", kind=\"said\")\ndef says_stop(e):\n    if \"stop\" in e.text.lower():\n        stop()\n        output(\"stop\")\n"
   },
   "version": "2.0.0"
  },
  "wake": {
   "type": "relay",
   "title": "Wake word",
   "settings": {
    "script": "@on(\"*\", kind=\"said\")\ndef wake_word(e):\n    if any(word in e.text.lower() for word in [\"computer\"]):\n        output(\"yes\")\n"
   },
   "version": "2.0.0"
  },
  "follow_up": {
   "type": "relay",
   "title": "Follow-up",
   "settings": {
    "script": "@on(\"*\", kind=\"said\")\ndef follow_up(e):\n    # you started talking less than 6 s after AAC spoke at that satellite (long answers too)\n    spoke = audio.satellites.get(e.data.get(\"mic\"), {}).get(\"seconds\", 999999)\n    said_for = e.data.get(\"seconds\") or 0\n    named = any(word in e.text.lower() for word in [\"stop\", \"computer\"])\n    if not e.data.get(\"aac_spoke\") and spoke - said_for < 6 and not named:\n        output(\"yes\")\n"
   },
   "version": "2.0.0"
  },
  "spoken": {
   "type": "relay",
   "title": "Spoken turn",
   "settings": {
    "script": "@new(\"rules\", at=\"end\", replace=False)\ndef rules(e):\n    e.text = \"\"\"You are heard and answer aloud: one or two short sentences, plain words, no lists. If you need to look something up or do something, call the tool first, then answer.\"\"\"\n"
   },
   "version": "2.0.0"
  },
  "followed": {
   "type": "relay",
   "title": "Follow-up turn",
   "settings": {
    "script": "@new(\"rules\", at=\"end\", replace=False)\ndef rules(e):\n    e.text = \"\"\"You are heard and answer aloud: one or two short sentences, plain words, no lists. If you need to look something up or do something, call the tool first, then answer.\"\"\"\n\n@on(\"ears.heard\")\ndef maybe_not_for_me(e):\n    e.text = \"(Said right after you spoke aloud; it may not be meant for you. If it is not, answer only: nothing) \" + e.text\n"
   },
   "version": "2.0.0"
  },
  "answer": {
   "type": "relay",
   "title": "Answer",
   "settings": {},
   "version": "2.0.0"
  }
 },
 "wires": [
  {
   "from": "chat.said",
   "to": "charter.in"
  },
  {
   "from": "charter.out",
   "to": "time.in"
  },
  {
   "from": "time.out",
   "to": "model.in"
  },
  {
   "from": "model.out",
   "to": "lists.in"
  },
  {
   "from": "lists.out",
   "to": "model.in"
  },
  {
   "from": "model.out",
   "to": "home.in"
  },
  {
   "from": "home.out",
   "to": "model.in"
  },
  {
   "from": "model.out",
   "to": "calendar.in"
  },
  {
   "from": "calendar.out",
   "to": "model.in"
  },
  {
   "from": "mic.out",
   "to": "cut.in"
  },
  {
   "from": "cut.out",
   "to": "ears.in"
  },
  {
   "from": "ears.out",
   "to": "stop_word.in"
  },
  {
   "from": "ears.out",
   "to": "wake.in"
  },
  {
   "from": "ears.out",
   "to": "follow_up.in"
  },
  {
   "from": "wake.yes",
   "to": "spoken.in"
  },
  {
   "from": "follow_up.yes",
   "to": "followed.in"
  },
  {
   "from": "answer.out",
   "to": "voice.in"
  },
  {
   "from": "voice.out",
   "to": "speaker.in"
  },
  {
   "from": "stop_word.stop",
   "to": "charter.in"
  },
  {
   "from": "spoken.out",
   "to": "charter.in"
  },
  {
   "from": "followed.out",
   "to": "charter.in"
  },
  {
   "from": "chat.provides",
   "to": "spoken.reads"
  },
  {
   "from": "chat.provides",
   "to": "followed.reads"
  },
  {
   "from": "answer.out",
   "to": "chat.answers"
  },
  {
   "from": "model.out",
   "to": "answer.in"
  }
 ],
 "positions": {
